# Native source crypto is deliberate: current official sheng macOS uses the same mode.
# The OS default 'prelinked' drops prng_random definitions still used by OSKext.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/tb710fu-cdc-log/libTb710fuCdcLog.a -Wl,-force_load,{tree}/build/tb710fu-live-log/libTb710fuLiveLog.a -Wl,-force_load,{tree}/build/tb710fu-source-storage/libTb710fuSourceStorage.a -Wl,-force_load,{tree}/build/tb710fu-macos27-services/libTb710fuMacos27Services.a -Wl,-force_load,{tree}/build/tb710fu-gop-display/libTb710fuGopDisplay.a -Wl,-force_load,{tree}/build/tb710fu-power/libTb710fuPower.a -Wl,-force_load,{tree}/build/tb710fu-adsp/libTb710fuAdsp.a -Wl,-force_load,{tree}/build/tb710fu-gpu/libTb710fuGpu.a"
CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-unnecessary-virtual-specifier -Wno-suggest-destructor-override -Wno-ms-bitfield-padding -DXNU_TB710FU_SOURCE_STORAGE=1 -DXNU_TB710FU_CDC=1 -DXNU_TB710FU_LIVE_LOG=1 -DXNU_TB710FU_OWNER_AUTH_OPEN=1 -DXNU_TB710FU_MACOS27_SERVICES=1 -DXNU_TB710FU_POWER=1 -DXNU_TB710FU_ADSP=1 -DXNU_TB710FU_GPU=1"

# Link the authenticated source runtime and its explicit bsd_init entry.
# The archive recipe must pass; storage/root mount and hardware boot remain unqualified.
CONFIG_XNU_SOURCE_STORAGE=y
# SourceStorage creates the service after loading the original storage family.
# Keep the separate automatic NativeUfs personalities disabled.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
# launchd reached userspace (run 45214948832) but exited 0 because the writable
# Data volume and SystemOS/Preboot cryptex view were never mounted. Enable the
# complete upstream chain (RamBlock -> CACHE_MOUNT -> CACHE_STARTUP ->
# BOOT_MANIFEST -> DATA_MOUNT -> UNION_SYSTEMOS) with a fixed Data volume UUID
# matching the macos-userdata.yml seed run.
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="A7B710F0-8650-4D27-9A01-26C5035F0001"
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
