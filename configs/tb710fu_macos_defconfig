# Native source crypto is deliberate: current official sheng macOS uses the same mode.
# The OS default 'prelinked' drops prng_random definitions still used by OSKext.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/tb710fu-cdc-log/libTb710fuCdcLog.a -Wl,-force_load,{tree}/build/tb710fu-source-storage/libTb710fuSourceStorage.a"
CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-unnecessary-virtual-specifier -Wno-suggest-destructor-override -Wno-ms-bitfield-padding -DXNU_TB710FU_SOURCE_STORAGE=1"

# Link the authenticated source runtime and its explicit bsd_init entry.
# The archive recipe must pass; storage/root mount and hardware boot remain unqualified.
CONFIG_XNU_SOURCE_STORAGE=y
# SourceStorage creates the service after loading the original storage family.
# Keep the separate automatic NativeUfs personalities disabled.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
