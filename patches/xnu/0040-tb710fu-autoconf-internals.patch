From: TB710FU clean board
Subject: [PATCH] Bracket bsd_autoconf internals with boot marks

Source: XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f, patch 0039 and the
device photo of run 44935038733's candidate.

The bottom band read BSD autocbeg while the scrolling log still ended at the
DLIL wait, so `bsd_init()` reached the call but the next mark never appeared.
`bsd_autoconf()` brackets three distinct stages without any mark inside them:
kminit, the pseudo-device initialiser loop, and IOKitBSDInit. A stop anywhere
inside exposes only autocbeg, which cannot be attributed.

Mark all three stages and each pseudo initialiser, so the next boot names the
stage instead of the caller.
---

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1431,20 +1431,34 @@
 kern_return_t
 bsd_autoconf(void)
 {
+	TB710FU_BSD_MARK("kminibeg");
 	kprintf("bsd_autoconf: calling kminit\n");
 	kminit();
+	TB710FU_BSD_MARK("kminiret");
 
 	/*
 	 * Early startup for bsd pseudodevices.
 	 */
 	{
 		struct pseudo_init *pi;
+		unsigned tbfu_pi_index = 0;
 
+		TB710FU_BSD_MARK("pseudobeg");
 		for (pi = pseudo_inits; pi->ps_func; pi++) {
+			/* Publish which initialiser is running before entering it:
+			 * a stop inside one of them otherwise looks like the loop. */
+			TB710FU_BSD_MARK(tbfu_pi_index == 0 ? "pseudo000" :
+			    tbfu_pi_index == 1 ? "pseudo001" :
+			    tbfu_pi_index == 2 ? "pseudo002" :
+			    tbfu_pi_index == 3 ? "pseudo003" : "pseudo004");
 			(*pi->ps_func)(pi->ps_count);
+			++tbfu_pi_index;
 		}
+		TB710FU_BSD_MARK("pseudoret");
 	}
 
+	TB710FU_BSD_MARK("iokitbeg");
 	kern_return_t result = IOKitBSDInit();
+	TB710FU_BSD_MARK("iokitret");
 #if (DEVELOPMENT || DEBUG) && defined(XNU_NATIVE_LEGACY_DISPLAY) && XNU_NATIVE_LEGACY_DISPLAY
 	/* The original IOSurface personality requires the genuine IOBSD resource.
 	 * The default-off framebuffer instrument may start only after publication.
 	 */
 	extern void native_legacy_display_late_probe(void);
+	TB710FU_BSD_MARK("lateprbe");
 	native_legacy_display_late_probe();
+	TB710FU_BSD_MARK("lateprbt");
 #endif
 	return result;
 }
