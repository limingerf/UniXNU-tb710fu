From: TB710FU clean board
Subject: [PATCH] Bracket bsd_autoconf internals with boot marks

Source: XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f, patch 0039 and the
device photo of run 44935038733's candidate.

The bottom band read BSD autocbeg while the scrolling log still ended at the
DLIL wait, so `bsd_init()` reached the call but the next mark never appeared.
`bsd_autoconf()` brackets three distinct stages without any mark inside them:
kminit, the pseudo-device initialiser loop, and IOKitBSDInit. A stop anywhere
inside exposes only autocbeg, which cannot be attributed.

Mark all three stages and each pseudo initialiser, so the next boot names the
stage instead of the caller.
---

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index ffe7ce0..3e79728 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1112,21 +1112,62 @@ bsdinit_task(void)
 kern_return_t
 bsd_autoconf(void)
 {
+	TB710FU_BSD_MARK("kminibeg");
 	kprintf("bsd_autoconf: calling kminit\n");
 	kminit();
+	TB710FU_BSD_MARK("kminiret");
 
 	/*
 	 * Early startup for bsd pseudodevices.
 	 */
 	{
 		struct pseudo_init *pi;
-
+		unsigned tbfu_pi_index = 0;
+		unsigned tbfu_pi_total = 0;
+		struct pseudo_init *tbfu_scan;
+		static const char tbfu_hex[] = "0123456789abcdef";
+
+		/* Count the table first: it is generated from the kernel
+		 * configuration, so its length is not a source constant and a
+		 * fixed set of lane names would merge the tail entries. */
+		for (tbfu_scan = pseudo_inits; tbfu_scan->ps_func; tbfu_scan++)
+			++tbfu_pi_total;
+		TB710FU_BSD_TEXT("pseudo-count", "total=%u\n", tbfu_pi_total);
+
+		TB710FU_BSD_MARK("pseudobg");
 		for (pi = pseudo_inits; pi->ps_func; pi++) {
+			/* The band keeps 12 columns with a 4-character "BSD " prefix,
+			 * so a lane label carries exactly 8 characters. Render the
+			 * table index and the low byte of ps_count as hex pairs, which
+			 * distinguishes whatever entries the configuration has. The
+			 * full record goes to the scrolling log instead. */
+			char tbfu_lane[9];
+			tbfu_lane[0] = 'p';
+			tbfu_lane[1] = tbfu_hex[(tbfu_pi_index >> 4) & 15u];
+			tbfu_lane[2] = tbfu_hex[tbfu_pi_index & 15u];
+			tbfu_lane[3] = '_';
+			tbfu_lane[4] = tbfu_hex[((unsigned)pi->ps_count >> 4) & 15u];
+			tbfu_lane[5] = tbfu_hex[(unsigned)pi->ps_count & 15u];
+			tbfu_lane[6] = '/';
+			tbfu_lane[7] = tbfu_hex[tbfu_pi_total & 15u];
+			tbfu_lane[8] = '\0';
+			TB710FU_BSD_TEXT("pseudo-enter",
+			    "index=%u count=%d total=%u\n",
+			    tbfu_pi_index, pi->ps_count, tbfu_pi_total);
+			TB710FU_BSD_MARK(tbfu_lane);
 			(*pi->ps_func)(pi->ps_count);
+			TB710FU_BSD_TEXT("pseudo-leave", "index=%u count=%d\n",
+			    tbfu_pi_index, pi->ps_count);
+			++tbfu_pi_index;
 		}
+		TB710FU_BSD_TEXT("pseudo-done", "ran=%u of %u\n",
+		    tbfu_pi_index, tbfu_pi_total);
+		TB710FU_BSD_MARK("pseudort");
 	}
 
+	TB710FU_BSD_MARK("iokitbeg");
 	return IOKitBSDInit();
+	TB710FU_BSD_MARK("iokitret");
 }
 
 
