Match 4K BCM2837 user pmap TTBR0 geometry (39-bit / 512 GiB) to macOS 27 user VA space.

Hardware evidence (pl21-vctext-pure, vc-text=1):
  panic(cpu 3 caller 0xfffffff00bb7224c): pmap_enter_options_internal: attempt to map illegal VA 0x73e200040000 in pmap 0xfffffff006d5c34000 @pmap.c:6298

Fix:
- Set T0SZ_BOOT = 25ULL on 4K XNU_TARGET_OS_OSX and keep T1SZ_BOOT == T0SZ_BOOT == 25ULL so
  start.s, kernel_pmap, and pmap_pt_attr_4k all share the exact same 39-bit (512 GiB, 512 L1
  entries = 4096 B) geometry.
- Clamp 4K XNU_TARGET_OS_OSX MACH_VM_MAX_ADDRESS_RAW to 0x0000007FFFE00000ULL (512 GiB - 2 MiB,
  matching macOS-DroidVM virt-user-va-512g) so xzone malloc's 455..512 GiB range fits inside
  [0, MACH_VM_MAX_ADDRESS) < pmap->max (0x8000000000).
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 51fdc9d..61eab86 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -1097,7 +1097,11 @@
 #endif /* !__ARM64_PMAP_SUBPAGE_L1__ */
 #else /* __ARM_16K_PG__ */
 #if __ARM64_PMAP_SUBPAGE_L1__
+#if XNU_TARGET_OS_OSX
+#define T0SZ_BOOT 25ULL
+#else /* !XNU_TARGET_OS_OSX */
 #define T0SZ_BOOT 26ULL
+#endif /* XNU_TARGET_OS_OSX */
 #else /* __ARM64_PMAP_SUBPAGE_L1__ */
 #define T0SZ_BOOT 25ULL
 #endif /* __ARM64_PMAP_SUBPAGE_L1__ */
diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
index 2adbe8b..c5fcbfd 100644
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -155,8 +155,13 @@ extern int PAGE_SHIFT_CONST;
  * the commpage nesting region and the GPU carveout stay reserved in every map (vm_reserved_regions).
  */
 #undef MACH_VM_MAX_ADDRESS_RAW
+#if !defined(__ARM_16K_PG__)
+/* 4K 3-level user pmaps (T0SZ_BOOT=25) cover 39 bits (512 GiB); keep user VA within pmap->max. */
+#define MACH_VM_MAX_ADDRESS_RAW 0x0000007FFFE00000ULL
+#else
 #define MACH_VM_MAX_ADDRESS_RAW 0x00007FFFFE000000ULL
 #endif
+#endif
 /* threshold for allocations to be placed in the large file range */
 #define VM_LARGE_FILE_THRESHOLD (1ULL << 30)
 #define MACH_VM_JUMBO_ADDRESS ((mach_vm_offset_t) 0x0000000FC0000000ULL)
