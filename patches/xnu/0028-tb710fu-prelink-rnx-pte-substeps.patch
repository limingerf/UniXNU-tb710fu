From: TB710FU clean board
Subject: [PATCH] Report completed PRELINKTEXT PTE substeps

Source: XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f after device patch 0027.

Reason: the observed QR logs the current PTE index before update_or_defer_tte.
Count only active PRELINKTEXT entries and report the next index and VA after
each 16 completed update_or_defer_tte calls. This keeps the first report aligned
to 16 real updates even when the range starts partway through an L3 table. The
checkpoint path updates bounded text and captures the log tail; mapping entries
and their order remain unchanged.

Verification: apply after 0027 on the pinned XNU fixture, verify the actual
arm_vm_page_granular_helper checkpoint branch and run the official integrated
macOS build/prelink/parser workflow.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 5cfd7d2d24d6e90f8b5aa5e138a14ef6745e67a3..f03c10dfc3e7c860d490747973b009c2e1c37c94 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1304,7 +1304,8 @@ arm_vm_page_granular_helper(vm_offset_t start, vm_offset_t _end, vm_offset_t va,
 	const int prelink_rnx = tb710fu_live_log_active() &&
 	    start >= segPRELINKTEXTB &&
 	    _end <= segPRELINKTEXTB + segSizePRELINKTEXT;
+	unsigned prelink_rnx_completed = 0;
 #endif
 	if (va & ARM_TT_L2_OFFMASK) { /* ragged edge hanging over a ARM_TT_L2_SIZE  boundary */
 		tt_entry_t *tte2;
 		tt_entry_t tmplate;
@@ -1455,7 +1456,14 @@ arm_vm_page_granular_helper(vm_offset_t start, vm_offset_t _end, vm_offset_t va,
 				assert(!kva_active || (ppte[i] == ARM_PTE_EMPTY) || ((ppte[i] & ARM_PTE_HINT) == (ptmp & ARM_PTE_HINT)));
 
 				update_or_defer_tte(&ppte[i], ptmp, pa, (vm_map_address_t)ppte, granule, deferred_ttep_pair, deferred_tte_pair);
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+				if (prelink_rnx && (++prelink_rnx_completed & 15u) == 0u) {
+					kprintf("TB710FU lockdown: prelink-rnx pte-done completed=%u next-i=%u next-va=%p\n",
+					    prelink_rnx_completed, i + 1u, (void *)(va + ARM_PGBYTES));
+					tb710fu_live_log_checkpoint("ld-prelink-rnx-pte-done");
+				}
+#endif
 			}
 
 			va += ARM_PGBYTES;
 			pa += ARM_PGBYTES;
 		}
