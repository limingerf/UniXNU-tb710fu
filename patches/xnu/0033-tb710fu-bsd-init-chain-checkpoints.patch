 #endif
+	TB710FU_BSD_TEXT("dev-probes", "done\n");
 #endif
 
 #if CONFIG_PROC_UUID_POLICY
 	/* Initial proc_uuid_policy subsystem */
 	bsd_init_kprintf("calling proc_uuid_policy_init()\n");
+	TB710FU_BSD_TEXT("proc-uuid-policy", "begin\n");
 	proc_uuid_policy_init();
+	TB710FU_BSD_TEXT("proc-uuid-policy", "done\n");
 #endif
 
 #if SOCKETS
@@ -868,6 +885,7 @@ bsd_init(void)
 	/* Initialize mbuf's. */
 	bsd_init_kprintf("calling mbinit\n");
 	mbinit();
+	TB710FU_BSD_TEXT("mbinit", "done\n");
 	restricted_in_port_init();
 #endif /* SOCKETS */
 
@@ -878,15 +896,18 @@ bsd_init(void)
 #if CONFIG_AUDIT
