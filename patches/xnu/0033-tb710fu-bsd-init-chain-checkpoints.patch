 	bsd_init_kprintf("calling eventhandler_init\n");
 	eventhandler_init();
+	TB710FU_BSD_TEXT("eventhandler-init", "done\n");
 
 	/* Initialize for async IO */
 	bsd_init_kprintf("calling aio_init\n");
@@ -898,6 +919,7 @@ bsd_init(void)
 	pshm_cache_init();
 	bsd_init_kprintf("calling psem_cache_init\n");
 	psem_cache_init();
+	TB710FU_BSD_TEXT("shm-sem-init", "done\n");
 
 	/*
 	 * Initialize protocols.  Block reception of incoming packets
@@ -914,6 +936,7 @@ bsd_init(void)
 	socketinit();
 	bsd_init_kprintf("calling domaininit\n");
 	domaininit();
+	TB710FU_BSD_TEXT("domain-init", "done\n");
 	iptap_init();
 #if FLOW_DIVERT
 	flow_divert_init();
@@ -954,6 +977,7 @@ bsd_init(void)
 
 	bsd_init_kprintf("calling sysctl_mib_init\n");
 	sysctl_mib_init();
+	TB710FU_BSD_TEXT("sysctl-mib", "done\n");
 #if defined(XNU_VERIFIED_ROOT_PROBE) && XNU_VERIFIED_ROOT_PROBE
