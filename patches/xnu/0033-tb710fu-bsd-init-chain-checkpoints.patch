+	TB710FU_BSD_TEXT("smmu4k-probe", "begin\n");
 	native_smmu4k_probe();
+	TB710FU_BSD_TEXT("smmu4k-probe", "done\n");
 #endif
 #if defined(XNU_CONSTANT_UPLOADS_PROBE) && XNU_CONSTANT_UPLOADS_PROBE
