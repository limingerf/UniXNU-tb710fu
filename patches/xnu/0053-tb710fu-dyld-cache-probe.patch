diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 0906700..1fa13c0 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -79,6 +79,88 @@ __XNU_PRIVATE_EXTERN    int             syscalls_log[SYS_MAXSYSCALL];
 extern int mach_trap_count;
 #endif
 
+/*
+ * tb710fu: capture the exact arguments of the syscalls launchd loops on while
+ * dyld refuses the shared cache. See docs/LAUNCHD_SYSCALL_LOOP.md.
+ *
+ * Patch 0043 recorded only (code, error), which proved the six-call loop exists
+ * and that every call succeeds, but it cannot explain why dyld munmaps after a
+ * successful mmap. These records keep the arguments and the return value.
+ *
+ * Written round-robin as groups of four u64 in a 64-slot ring:
+ *   [0] tag, [1] argA, [2] argB, [3] argC
+ */
+volatile uint64_t tb710fu_dyld_probe[64] = { 0 };
+volatile uint32_t tb710fu_dyld_probe_idx = 0;
+
+static inline void
+tb710fu_dyld_probe_put(uint32_t tag, uint64_t a, uint64_t b, uint64_t c)
+{
+	uint32_t slot = __atomic_fetch_add(&tb710fu_dyld_probe_idx, 4u,
+	    __ATOMIC_RELAXED) & 63u;
+
+	tb710fu_dyld_probe[slot] = tag;
+	tb710fu_dyld_probe[(slot + 1u) & 63u] = a;
+	tb710fu_dyld_probe[(slot + 2u) & 63u] = b;
+	tb710fu_dyld_probe[(slot + 3u) & 63u] = c;
+}
+
+#if DEVELOPMENT || DEBUG
+volatile uint32_t tb710fu_pid1_sc_count = 0;
+volatile uint32_t tb710fu_pid1_sc_in = 0;
+volatile uint32_t tb710fu_pid1_sc_cur = 0;
+volatile uint64_t tb710fu_pid1_sc_arg0 = 0;
+volatile uint64_t tb710fu_pid1_sc_arg1 = 0;
+volatile uint32_t tb710fu_pid1_sc_ring[16] = { 0 };
+volatile uint32_t tb710fu_pid1_sc_idx = 0;
+char tb710fu_pid1_last_sysctl[96] = { 0 };
+int tb710fu_pid1_last_mib[4] = { 0 };
+int tb710fu_pid1_last_sysctl_err = 0;
+char tb710fu_pid1_last_open[96] = { 0 };
+
+static inline void
+tb710fu_pid1_sc_enter(unsigned short code, uint64_t arg0, uint64_t arg1)
+{
+	tb710fu_pid1_sc_cur = (uint32_t)code;
+	tb710fu_pid1_sc_arg0 = arg0;
+	tb710fu_pid1_sc_arg1 = arg1;
+	tb710fu_pid1_sc_in = 1;
+	__atomic_fetch_add(&tb710fu_pid1_sc_count, 1u, __ATOMIC_RELAXED);
+	if (code == 441 || code == 5 || code == 398) {
+		size_t done = 0;
+		char tmp[96];
+		if (copyinstr((user_addr_t)arg0, tmp, sizeof(tmp), &done) == 0) {
+			tmp[sizeof(tmp) - 1] = '\0';
+			memcpy(tb710fu_pid1_last_open, tmp, sizeof(tmp));
+		}
+	}
+}
+
+static inline void
+tb710fu_pid1_sc_exit(unsigned short code, int error, uint64_t arg0, uint64_t arg1, uint64_t arg4)
+{
+	uint32_t slot = __atomic_fetch_add(&tb710fu_pid1_sc_idx, 1u, __ATOMIC_RELAXED) & 15u;
+	tb710fu_pid1_sc_ring[slot] = ((uint32_t)code << 16) | ((uint32_t)error & 0xffffu);
+	tb710fu_pid1_sc_in = 0;
+	if (code == 202 && error != 0) {
+		int mib[4] = { 0, 0, 0, 0 };
+		uint32_t n = (arg1 > 4) ? 4u : (uint32_t)arg1;
+		if (n > 0 && copyin((user_addr_t)arg0, mib, n * sizeof(int)) == 0) {
+			memcpy(tb710fu_pid1_last_mib, mib, sizeof(mib));
+			tb710fu_pid1_last_sysctl_err = error;
+			if (mib[0] == 0 && mib[1] == 3 && arg4 != 0) {
+				size_t done = 0;
+				char tmp[96];
+				if (copyinstr((user_addr_t)arg4, tmp, sizeof(tmp), &done) == 0) {
+					tmp[sizeof(tmp) - 1] = '\0';
+					memcpy(tb710fu_pid1_last_sysctl, tmp, sizeof(tmp));
+				}
+			}
+		}
+	}
+}
+#endif /* DEVELOPMENT || DEBUG */
+
 /*
  * Function:	unix_syscall
  *
@@ -178,7 +260,54 @@ unix_syscall(
 #endif /* CONFIG_DEBUG_SYSCALL_REJECTION */
 
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
+#if DEVELOPMENT || DEBUG
+	if (pid == 1) {
+		tb710fu_pid1_sc_enter(code, (uint64_t)uthread->uu_arg[0], (uint64_t)uthread->uu_arg[1]);
+	}
+#endif
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
+	/*
+	 * tb710fu: full-argument capture for the dyld cache retry loop.
+	 * pid 1 only, so nothing else is perturbed.
+	 */
+	if (pid == 1) {
+		switch (code) {
+		case 463: /* openat(dirfd, path, flags, mode) */
+			tb710fu_dyld_probe_put(0x4F41544Eu,
+			    (uint64_t)uthread->uu_arg[1],
+			    (uint64_t)uthread->uu_arg[2],
+			    (uint64_t)(long)uthread->uu_rval[0]);
+			break;
+		case 197: /* mmap(addr, len, prot, flags, fd, off) */
+			tb710fu_dyld_probe_put(0x4D4D4150u,
+			    ((uint64_t)uthread->uu_arg[2] << 32) |
+			    ((uint64_t)uthread->uu_arg[3] & 0xffffffffu),
+			    (uint64_t)uthread->uu_arg[4],
+			    (uint64_t)(long)uthread->uu_rval[0]);
+			break;
+		case 92: /* fcntl(fd, cmd, arg) */
+			tb710fu_dyld_probe_put(0x464E4354u,
+			    (uint64_t)uthread->uu_arg[0],
+			    (uint64_t)uthread->uu_arg[1],
+			    (uint64_t)(long)uthread->uu_rval[0]);
+			break;
+		case 73: /* munmap(addr, len) */
+			tb710fu_dyld_probe_put(0x4D554E4Du,
+			    (uint64_t)uthread->uu_arg[0],
+			    (uint64_t)uthread->uu_arg[1],
+			    (uint64_t)0);
+			break;
+		default:
+			break;
+		}
+	}
+
+
+#if DEVELOPMENT || DEBUG
+	if (pid == 1) {
+		tb710fu_pid1_sc_exit(code, error, (uint64_t)uthread->uu_arg[0], (uint64_t)uthread->uu_arg[1], (uint64_t)uthread->uu_arg[4]);
+	}
+#endif
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 
 #if CONFIG_MACF
