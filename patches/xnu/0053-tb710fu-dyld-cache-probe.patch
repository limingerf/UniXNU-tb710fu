diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 1fb7821..c9d940a 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -92,6 +92,63 @@ int tb710fu_pid1_last_mib[4] = { 0 };
 int tb710fu_pid1_last_sysctl_err = 0;
 char tb710fu_pid1_last_open[96] = { 0 };
 
+/*
+ * tb710fu: capture the exact arguments of the syscalls launchd loops on while
+ * dyld refuses the shared cache. See docs/LAUNCHD_SYSCALL_LOOP.md.
+ *
+ * Patch 0043 recorded only (code, error), which proved the six-call loop exists
+ * and that every call succeeds, but it cannot explain why dyld munmaps after a
+ * successful mmap. These records keep the arguments and the return value.
+ *
+ *
+ * Return values are 64-bit and the kernel splits them across uu_rval[0] and
+ * uu_rval[1] (see the ss64 save path in this same file), so both halves are
+ * combined. Reading only uu_rval[0] reported mmap's 0x1009a0000 as 0x9a0000,
+ * which looked like dyld unmapping a different address than it mapped.
+ * Written round-robin as groups of four u64 in a 64-slot ring:
+ *   [0] tag, [1] argA, [2] argB, [3] argC
+ */
+volatile uint64_t tb710fu_dyld_probe[64] = { 0 };
+volatile uint32_t tb710fu_dyld_probe_idx = 0;
+/*
+ * First 32 bytes of the most recent successful mmap, captured while the mapping
+ * is still live (the matching munmap follows immediately). Compared against the
+ * file header read with cat: a difference would prove the 4K-page mapping does
+ * not expose the bytes the 16K-page cache layout describes.
+ */
+volatile uint8_t tb710fu_dyld_probe_head[32] = { 0 };
+volatile uint32_t tb710fu_dyld_probe_head_ok = 0;
+
+/*
+ * noinline so the function leaves a symbol in the image. That makes its
+ * presence verifiable by name instead of by searching for materialised
+ * immediates: an earlier inline form lost the openat and fcntl arms entirely
+ * (0x4F41544E and 0x464E4354 absent at every offset in pl107), which would have
+ * silently hidden the two calls that identify the file and the fd being signed.
+ *
+ * Tags are byte strings for the same reason -- a 4-byte immediate can be
+ * assembled with movz/movk or folded away, a string cannot.
+ */
+__attribute__((noinline))
+static void
+tb710fu_dyld_probe_put(const char tag[4], uint64_t a, uint64_t b, uint64_t c)
+{
+	uint32_t slot;
+
+	__asm__ __volatile__("" ::: "memory");
+	slot = __atomic_fetch_add(&tb710fu_dyld_probe_idx, 4u,
+	    __ATOMIC_RELAXED) & 63u;
+	tb710fu_dyld_probe[slot] =
+	    ((uint64_t)(unsigned char)tag[0] << 24) |
+	    ((uint64_t)(unsigned char)tag[1] << 16) |
+	    ((uint64_t)(unsigned char)tag[2] << 8) |
+	     (uint64_t)(unsigned char)tag[3];
+	tb710fu_dyld_probe[(slot + 1u) & 63u] = a;
+	tb710fu_dyld_probe[(slot + 2u) & 63u] = b;
+	tb710fu_dyld_probe[(slot + 3u) & 63u] = c;
+	__asm__ __volatile__("" ::: "memory");
+}
+
 static inline void
 tb710fu_pid1_sc_enter(unsigned short code, uint64_t arg0, uint64_t arg1)
 {
@@ -244,6 +301,57 @@ unix_syscall(
 	if (pid == 1) {
 		tb710fu_pid1_sc_exit(code, error, (uint64_t)uthread->uu_arg[0], (uint64_t)uthread->uu_arg[1], (uint64_t)uthread->uu_arg[4]);
 	}
+#endif
+#if DEVELOPMENT || DEBUG
+	if (pid == 1) {
+		switch (code) {
+		case 463: /* openat(dirfd, path, flags, mode) */
+			tb710fu_dyld_probe_put("OATN",
+			    (uint64_t)uthread->uu_arg[1],
+			    (uint64_t)uthread->uu_arg[2],
+			    ((uint64_t)(uint32_t)uthread->uu_rval[0] | ((uint64_t)(uint32_t)uthread->uu_rval[1] << 32)));
+			break;
+		case 197: /* mmap(addr, len, prot, flags, fd, off) */
+			tb710fu_dyld_probe_put("MMAP",
+			    ((uint64_t)uthread->uu_arg[2] << 32) |
+			    ((uint64_t)uthread->uu_arg[3] & 0xffffffffu),
+			    (uint64_t)uthread->uu_arg[4],
+			    ((uint64_t)(uint32_t)uthread->uu_rval[0] | ((uint64_t)(uint32_t)uthread->uu_rval[1] << 32)));
+			break;
+		case 92: /* fcntl(fd, cmd, arg) */
+			tb710fu_dyld_probe_put("FNCT",
+			    (uint64_t)uthread->uu_arg[0],
+			    (uint64_t)uthread->uu_arg[1],
+			    ((uint64_t)(uint32_t)uthread->uu_rval[0] | ((uint64_t)(uint32_t)uthread->uu_rval[1] << 32)));
+			break;
+		case 73: /* munmap(addr, len) */
+			tb710fu_dyld_probe_put("MUNM",
+			    (uint64_t)uthread->uu_arg[0],
+			    (uint64_t)uthread->uu_arg[1],
+			    (uint64_t)0);
+			{
+				uint64_t ua = (uint64_t)uthread->uu_arg[0];
+				uint8_t head[32];
+
+				/* Read the mapping before it goes away. Sampling here
+				 * rather than in the mmap arm means the page has
+				 * usually been touched already, so copyin is unlikely
+				 * to fault inside the syscall-exit path. */
+				if (ua && copyin((user_addr_t)ua, head,
+				    sizeof(head)) == 0) {
+					for (uint32_t k = 0; k < sizeof(head); ++k) {
+						tb710fu_dyld_probe_head[k] = head[k];
+					}
+					tb710fu_dyld_probe_head_ok = 1;
+				} else {
+					tb710fu_dyld_probe_head_ok = 0;
+				}
+			}
+			break;
+		default:
+			break;
+		}
+	}
 #endif
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 
