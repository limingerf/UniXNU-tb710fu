Subject: [PATCH] tb710fu gate optional exit trace

Base: UniXNU 0c1bac3d51a3009dca1708b15a5198f4b43d057a; XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f
Apply after the complete selected arch / SoC / macOS OS series.
Gate the optional board exit-backtrace hook when its real BootUiTrace provider is unselected. Ordinary macOS exec/exit logging remains enabled independently.
No replacement function, global, authorization result, or security stub is added.

diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1606,11 +1606,13 @@
 void
 exit(proc_t p, struct exit_args *uap, int *retval)
 {
+#if defined(XNU_TB710FU_EXIT_TRACE) && XNU_TB710FU_EXIT_TRACE
 	/* exit-trace (BootUiTraceProbe.c, the board's): the user frames of a listed process's exit(), with the cache slide. */
 	extern void native_exit_trace(int pid, const char *name, int status) __attribute__((weak_import));
 	if (native_exit_trace) {
 		native_exit_trace(proc_getpid(p), p->p_comm, (int)uap->rval);
 	}
+#endif
 	p->p_xhighbits = ((uint32_t)(uap->rval) & 0xFF000000) >> 24;
 	exit1(p, W_EXITCODE((uint32_t)uap->rval, 0), retval);
 
