From: TB710FU clean board
Subject: [PATCH] Pace synchronous QR work in hot startup paths

Source: XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f with the
pinned boot-progress patch and the device series through 0023.

Reason: run 44479475027 renders whole QR frames for repeated kalloc and
startup callback markers. The device frame reached fallback assignment done.
Keep those records in the XNU capture ring and pace their synchronous QR
publication. Keep the outer kalloc, fixed and variable view boundaries and
bootstrap phase events immediate. Allocator and callback semantics are unchanged.

Verification: apply to the isolated pinned source in series order. Exercise a
burst, a slow render and a failed render with the production adapter under
host sanitizers. The native verifier checks both strong providers and direct
call sites in startup.o and kalloc.o.
---
 osfmk/kern/kalloc.c           | 31 ++++++++++++++++++-------------
 osfmk/kern/startup.c          |  4 ++--
 osfmk/kern/tb710fu_live_log.h |  1 +
 3 files changed, 21 insertions(+), 15 deletions(-)

diff --git a/osfmk/kern/kalloc.c b/osfmk/kern/kalloc.c
index ce6b75c..e57d49d 100644
--- a/osfmk/kern/kalloc.c
+++ b/osfmk/kern/kalloc.c
@@ -87,19 +87,23 @@
 #include <libkern/prelink.h>
 #if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
 #include <kern/tb710fu_live_log.h>
-#define TB710FU_KALLOC_EVENT(label, event) \
+#define TB710FU_KALLOC_LOG(label, event, publish) \
 	do { \
 		if (tb710fu_live_log_active()) { \
 			kprintf("TB710FU kalloc: %s %s\n", label, event); \
-			tb710fu_live_log_checkpoint(label); \
+			publish(label); \
 		} \
 	} while (0)
+#define TB710FU_KALLOC_EVENT(label, event) \
+	TB710FU_KALLOC_LOG(label, event, tb710fu_live_log_checkpoint_sampled)
+#define TB710FU_KALLOC_BOUNDARY(label, event) \
+	TB710FU_KALLOC_LOG(label, event, tb710fu_live_log_checkpoint)
 #define TB710FU_KALLOC_VALUE(label, value) \
 	do { \
 		if (tb710fu_live_log_active()) { \
 			kprintf("TB710FU kalloc: %s value=%u\n", label, \
 			    (uint32_t)(value)); \
-			tb710fu_live_log_checkpoint(label); \
+			tb710fu_live_log_checkpoint_sampled(label); \
 		} \
 	} while (0)
 #define TB710FU_KALLOC_PROGRESS(label, index, interval) \
@@ -111,7 +115,7 @@
 		    tb710fu_live_log_active()) { \
 			kprintf("TB710FU kalloc: %s index=%u\n", label, \
 			    tb710fu_progress_index); \
-			tb710fu_live_log_checkpoint(label); \
+			tb710fu_live_log_checkpoint_sampled(label); \
 		} \
 	} while (0)
 #define TB710FU_KALLOC_RANGE(label, event, index, total, interval) \
@@ -125,7 +129,7 @@
 		    tb710fu_live_log_active()) { \
 			kprintf("TB710FU kalloc: %s %s index=%u total=%u\n", label, event, \
 			    tb710fu_range_index, tb710fu_range_total); \
-			tb710fu_live_log_checkpoint(label); \
+			tb710fu_live_log_checkpoint_sampled(label); \
 		} \
 	} while (0)
 #define TB710FU_KALLOC_GROUP(event, class_idx, group_idx, group_total, \
@@ -136,7 +140,7 @@
 			    event, (uint32_t)(class_idx), (uint32_t)(group_idx), \
 			    (uint32_t)(group_total), (uint32_t)(view_start), \
 			    (uint32_t)(view_end)); \
-			tb710fu_live_log_checkpoint("fixed-group"); \
+			tb710fu_live_log_checkpoint_sampled("fixed-group"); \
 		} \
 	} while (0)
 #define TB710FU_KALLOC_CLASS(event, class_idx, sig_count, type_count) \
@@ -145,11 +149,12 @@
 			kprintf("TB710FU kalloc: fixed-class %s class=%u signatures=%u types=%u\n", \
 			    event, (uint32_t)(class_idx), (uint32_t)(sig_count), \
 			    (uint32_t)(type_count)); \
-			tb710fu_live_log_checkpoint("fixed-class"); \
+			tb710fu_live_log_checkpoint_sampled("fixed-class"); \
 		} \
 	} while (0)
 #else
 #define TB710FU_KALLOC_EVENT(label, event) do { } while (0)
+#define TB710FU_KALLOC_BOUNDARY(label, event) do { } while (0)
 #define TB710FU_KALLOC_VALUE(label, value) do { } while (0)
 #define TB710FU_KALLOC_PROGRESS(label, index, interval) do { } while (0)
 #define TB710FU_KALLOC_RANGE(label, event, index, total, interval) do { } while (0)
@@ -2237,7 +2242,7 @@ kalloc_init(void)
 	 */
 	uint64_t max_count = kt_count = kt_scratch_size / sizeof(kalloc_type_views_t);
 
-	TB710FU_KALLOC_EVENT("kalloc-init", "begin");
+	TB710FU_KALLOC_BOUNDARY("kalloc-init", "begin");
 	static_assert(KHEAP_MAX_SIZE >= KALLOC_SAFE_ALLOC_SIZE);
 	TB710FU_KALLOC_EVENT("zsize", "begin");
 	kalloc_zsize_compute();
@@ -2261,9 +2266,9 @@ kalloc_init(void)
 	/*
 	 * Handle fixed size views
 	 */
-	TB710FU_KALLOC_EVENT("fixed-views", "begin");
+	TB710FU_KALLOC_BOUNDARY("fixed-views", "begin");
 	kalloc_type_view_init_fixed();
-	TB710FU_KALLOC_EVENT("fixed-views", "done");
+	TB710FU_KALLOC_BOUNDARY("fixed-views", "done");
 
 	/*
 	 * Reset
@@ -2278,9 +2283,9 @@ kalloc_init(void)
 	/*
 	 * Handle variable size views
 	 */
-	TB710FU_KALLOC_EVENT("variable-views", "begin");
+	TB710FU_KALLOC_BOUNDARY("variable-views", "begin");
 	kalloc_type_view_init_var();
-	TB710FU_KALLOC_EVENT("variable-views", "done");
+	TB710FU_KALLOC_BOUNDARY("variable-views", "done");
 
 	/*
 	 * Free resources used
@@ -2288,7 +2293,7 @@ kalloc_init(void)
 	TB710FU_KALLOC_EVENT("scratch-free", "begin");
 	kmem_free(kernel_map, (vm_offset_t) kt_buffer, kt_scratch_size);
 	TB710FU_KALLOC_EVENT("scratch-free", "done");
-	TB710FU_KALLOC_EVENT("kalloc-init", "done");
+	TB710FU_KALLOC_BOUNDARY("kalloc-init", "done");
 }
 STARTUP(ZALLOC, STARTUP_RANK_THIRD, kalloc_init);
 
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 9001981..5c7109c 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -518,7 +518,7 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		if (tb710fu_live_log_active()) {
 			kprintf("TB710FU live log: startup callback begin [%u, rank %d] %p\n",
 			    cur->subsystem, cur->rank, cur->arg);
-			tb710fu_live_log_checkpoint("startup-callback-begin");
+			tb710fu_live_log_checkpoint_sampled("startup-callback-begin");
 		}
 #endif
 		cur->func(cur->arg);
@@ -526,7 +526,7 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		if (tb710fu_live_log_active()) {
 			kprintf("TB710FU live log: startup callback returned [%u, rank %d] %p\n",
 			    cur->subsystem, cur->rank, cur->arg);
-			tb710fu_live_log_checkpoint("startup-callback-return");
+			tb710fu_live_log_checkpoint_sampled("startup-callback-return");
 		}
 #endif
 		startup_entry_cur = ++cur;
diff --git a/osfmk/kern/tb710fu_live_log.h b/osfmk/kern/tb710fu_live_log.h
index 0b70857..9d9dc82 100644
--- a/osfmk/kern/tb710fu_live_log.h
+++ b/osfmk/kern/tb710fu_live_log.h
@@ -8,6 +8,7 @@ void tb710fu_live_log_putc(char c);
 void tb710fu_live_log_init(void);
 void tb710fu_live_log_poll(void);
 void tb710fu_live_log_checkpoint(const char *stage);
+void tb710fu_live_log_checkpoint_sampled(const char *stage);
 void tb710fu_live_log_refresh(void);
 void tb710fu_live_log_freeze(void);
 int tb710fu_live_log_active(void);
