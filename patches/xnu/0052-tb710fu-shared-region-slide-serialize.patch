Subject: [PATCH] tb710fu: serialize 4 KiB shared-region part slides per pager

native-4k-shared-region-slide.patch slides Darwin 26's 16 KiB v5 slide pages
one 4 KiB part at a time. Resolving a part's chain start walks earlier parts
through shared_region_pager_peek(), which faults the backing file again. APFS
pages a verified file in by whole verification blocks with one UPL over all
of the block's pages: when two threads slide different parts of the same
16 KiB page concurrently, one thread's peek can wait uninterruptibly for a
file page that the other thread's in-flight page-in still holds busy, while
that thread in turn waits for the first: a cross-thread busy-page deadlock
in the dyld shared-cache pager window (early launchd stall/reboot).

Add a sleepable per-pager lck_mtx_t (srp_slide_lock, existing
shared_region_pager_lck_grp), initialized in shared_region_pager_create()
and destroyed in shared_region_pager_deallocate_internal() before the pager
is freed. shared_region_pager_data_request() takes it around the outermost
shared_region_pager_slide_part() call - strictly after src_page and top_page
have been released, so a mutex waiter never holds a file page busy - and
drops it immediately after the call returns, covering every return path
(including the panic_on_dyld_issue path). slide_part() never recurses into
this pager (peek faults the backing vnode object, not the pager's memory
object), so the lock is never reacquired recursively; each 4 KiB part of a
multi-part data request locks/unlocks on its own.

Applies on top of the pinned native-4k-shared-region-slide.patch; no device
patch 0001-0051 touches this file. Verified with git apply --check and a
real apply against pristine XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f
plus that official patch (byte-identical to the prepared xnu-patch-lf-clean
fixture). Patch-application and host syntax checks only; no device test.

diff --git a/osfmk/vm/vm_shared_region_pager.c b/osfmk/vm/vm_shared_region_pager.c
index 5371c32..436387f 100644
--- a/osfmk/vm/vm_shared_region_pager.c
+++ b/osfmk/vm/vm_shared_region_pager.c
@@ -323,6 +323,7 @@ typedef struct shared_region_pager {
 #if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
 	uint16_t                *srp_part_starts;   /* 16 KiB slide pages: first rebase of each 4 KiB part, see shared_region_pager_slide_part() */
 	vm_size_t               srp_part_bytes;
+	lck_mtx_t               srp_slide_lock;     /* serializes the outermost part slide, see shared_region_pager_data_request() */
 #endif
 } *shared_region_pager_t;
 #define SHARED_REGION_PAGER_NULL        ((shared_region_pager_t) NULL)
@@ -929,7 +930,18 @@ retry_src_fault:
 					vm_object_unlock(src_top_object);
 					top_page = VM_PAGE_NULL;
 				}
+				/*
+				 * Serialize the whole part resolution per pager: two threads sliding different 4 KiB parts of
+				 * the same 16 KiB page both peek earlier parts from the file, and APFS verifies a whole block
+				 * with one UPL, so one thread's peek can wait for a file page the other's page-in holds busy
+				 * while that thread waits here: a cross-thread busy-page deadlock. The lock is taken only
+				 * after src_page and top_page are released (above), so a waiter never holds a file page busy,
+				 * and it is dropped right after the call on every return path. slide_part() never recurses
+				 * into this pager (peek faults the backing vnode object), so there is no recursive acquire.
+				 */
+				lck_mtx_lock(&pager->srp_slide_lock);
 				kr = shared_region_pager_slide_part(pager, dst_vaddr, offset_in_backing_object, slide_start_address, &fault_info);
+				lck_mtx_unlock(&pager->srp_slide_lock);
 				if (kr != KERN_SUCCESS) {
 					if (panic_on_dyld_issue) {
 						panic("%s(): shared region 4 KiB part slide error %d", __func__, kr);
@@ -1234,6 +1246,7 @@ shared_region_pager_deallocate_internal(
 			kfree_data(pager->srp_part_starts, pager->srp_part_bytes);
 			pager->srp_part_starts = NULL;
 		}
+		lck_mtx_destroy(&pager->srp_slide_lock, &shared_region_pager_lck_grp);
 #endif
 		if (pager->srp_header.mo_control != MEMORY_OBJECT_CONTROL_NULL) {
 			memory_object_control_deallocate(pager->srp_header.mo_control);
@@ -1429,6 +1442,7 @@ shared_region_pager_create(
 #if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
 	pager->srp_part_starts = NULL;
 	pager->srp_part_bytes = 0;
+	lck_mtx_init(&pager->srp_slide_lock, &shared_region_pager_lck_grp, LCK_ATTR_NULL);
 #endif
 	pager->srp_is_ready = FALSE;/* not ready until it has a "name" */
 	/* existence reference (for the cache) + 1 for the caller */
