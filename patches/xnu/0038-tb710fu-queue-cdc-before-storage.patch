From: TB710FU clean board
Subject: [PATCH] Queue CDC log transport before starting storage

Source: XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f and the patches
recorded by run 44891383574. The hook returns to the pre-VFS position
used by the device's 0012 and 0032 patches.

Start the asynchronous CDC worker after IOKit time initialization to
give it a scheduling opportunity while BSD starts storage. CDC uses
kernel VM, clocks and ArmCpu. The worker handles USB register access
and enumeration. BSD proceeds after dispatch. Raw cdcpre and cdcret
mark both sides before their text checkpoints enter the normal console.

Verification: reconstruct bsd_init.c from the pinned revision and
hash-checked run inputs, then apply and reverse the new patch.
---

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -813,6 +813,21 @@
 	IOKitInitializeTime();
 	TB710FU_BSD_TEXT("iokit-time-init", "done\n");
 
+#if defined(XNU_TB710FU_CDC) && XNU_TB710FU_CDC
+	/* Queue the independent log transport before VFS and storage start. */
+	extern void tb710fu_cdc_start(void);
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+	extern void tb710fu_live_log_boot_mark(unsigned, const char *);
+	tb710fu_live_log_boot_mark(0, "cdcpre");
+#endif
+	TB710FU_BSD_TEXT("cdc-start", "begin\n");
+	tb710fu_cdc_start();
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+	tb710fu_live_log_boot_mark(0, "cdcret");
+#endif
+	TB710FU_BSD_TEXT("cdc-start", "done\n");
+#endif
+
 	/* Initialize the file systems. */
 	bsd_init_kprintf("calling vfsinit\n");
 	TB710FU_BSD_TEXT("vfsinit", "begin\n");
@@ -823,14 +838,6 @@
 	TB710FU_BSD_TEXT("source-storage-start", "begin\n");
 	native_source_storage_start();
 	TB710FU_BSD_TEXT("source-storage-start", "done\n");
-#endif
-#if defined(XNU_TB710FU_CDC) && XNU_TB710FU_CDC
-	/* Started after the storage handoff so the platform verdict lands at the
-	 * tail of the boot log instead of scrolling away before root announces. */
-	extern void tb710fu_cdc_start(void);
-	TB710FU_BSD_TEXT("cdc-start", "begin\n");
-	tb710fu_cdc_start();
-	TB710FU_BSD_TEXT("cdc-start", "done\n");
 #endif
 #if DEVELOPMENT || DEBUG
 	TB710FU_BSD_TEXT("apfs-probe", "begin\n");
