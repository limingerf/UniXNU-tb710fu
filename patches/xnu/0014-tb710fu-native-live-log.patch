 	}
 	extern void tb710fu_cdc_log_tap_putc(char);
 	if (boot_progress_active()) { tb710fu_cdc_log_tap_putc(c); boot_progress_putc(c); return; }
@@ -292,10 +296,35 @@
  *             waiting for an interrupt when the hardware device isn't ready
  * @param size The number of characters to print to the console.
  */
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+/* Video acquisition disables console output before the usual _cnputc tap.
+ * Preserve the actual byte stream in that case without drawing or touching
+ * UART, and without duplicating the normal enabled-console path. */
+static void
+tb710fu_live_capture_disabled(const char *text, int size)
+{
+	if (text == NULL) {
+		return;
+	}
+	const bool active = tb710fu_live_log_active();
+	extern void tb710fu_cdc_log_tap_putc(char);
+	for (int i = 0; i < size; i++) {
+		if (text[i] != '\r') {
+			tb710fu_live_log_putc(text[i]);
+			if (active) { tb710fu_ramoops_putc(text[i]); }
+		}
+		tb710fu_cdc_log_tap_putc(text[i]);
+	}
+}
+#endif
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
 	if (disableConsoleOutput) {
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+		tb710fu_live_capture_disabled(c, size);
+#endif
 		return;
 	}
 
@@ -541,6 +570,9 @@
 console_write(char *str, int size)
 {
 	if (disableConsoleOutput) {
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+		tb710fu_live_capture_disabled(str, size);
+#endif
 		return;
 	}
 
@@ -626,6 +658,9 @@
 console_write_unbuffered(char c)
 {
 	if (disableConsoleOutput) {
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+		tb710fu_live_capture_disabled(&c, 1);
+#endif
 		return;
 	}
 
