@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: MIT
+#ifndef KERN_TB710FU_LIVE_LOG_H
+#define KERN_TB710FU_LIVE_LOG_H
+/* Strong device archive providers, selected together by the native recipe.
+ * No weak or empty provider is supplied when this component is disabled. */
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+void tb710fu_live_log_putc(char c);
+void tb710fu_live_log_init(void);
+void tb710fu_live_log_poll(void);
+void tb710fu_live_log_checkpoint(const char *stage);
+void tb710fu_live_log_refresh(void);
+void tb710fu_live_log_freeze(void);
+int tb710fu_live_log_active(void);
+#endif
+#endif
