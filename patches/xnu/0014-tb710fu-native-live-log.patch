diff --git a/osfmk/kern/tb710fu_live_log.h b/osfmk/kern/tb710fu_live_log.h
new file mode 100644
--- /dev/null
+++ b/osfmk/kern/tb710fu_live_log.h
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: MIT
+#ifndef KERN_TB710FU_LIVE_LOG_H
+#define KERN_TB710FU_LIVE_LOG_H
+/* Strong device archive providers, selected together by the native recipe.
+ * No weak or empty provider is supplied when this component is disabled. */
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+void tb710fu_live_log_init(void);
+void tb710fu_live_log_poll(void);
+void tb710fu_live_log_refresh(void);
+void tb710fu_live_log_freeze(void);
+int tb710fu_live_log_active(void);
+#endif
+#endif
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -1,5 +1,6 @@
 #include <kern/tb710fu_ramoops.h>
 #include <kern/boot_progress.h>
+#include <kern/tb710fu_live_log.h>
 /*
  * Copyright (c) 2000-2020 Apple, Inc. All rights reserved.
  *
@@ -292,10 +293,33 @@
  *             waiting for an interrupt when the hardware device isn't ready
  * @param size The number of characters to print to the console.
  */
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+/* Video acquisition disables console output before the usual _cnputc tap.
+ * Preserve the actual byte stream in that case without drawing or touching
+ * UART, and without duplicating the normal enabled-console path. */
+static void
+tb710fu_live_capture_disabled(const char *text, int size)
+{
+	if (!tb710fu_live_log_active() || text == NULL) {
+		return;
+	}
+	extern void tb710fu_cdc_log_tap_putc(char);
+	for (int i = 0; i < size; i++) {
+		if (text[i] != '\r') {
+			tb710fu_ramoops_putc(text[i]);
+		}
+		tb710fu_cdc_log_tap_putc(text[i]);
+	}
+}
+#endif
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
 	if (disableConsoleOutput) {
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+		tb710fu_live_capture_disabled(c, size);
+#endif
 		return;
 	}
 
@@ -541,6 +565,9 @@
 console_write(char *str, int size)
 {
 	if (disableConsoleOutput) {
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+		tb710fu_live_capture_disabled(str, size);
+#endif
 		return;
 	}
 
@@ -626,6 +653,9 @@
 console_write_unbuffered(char c)
 {
 	if (disableConsoleOutput) {
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+		tb710fu_live_capture_disabled(&c, 1);
+#endif
 		return;
 	}
 
