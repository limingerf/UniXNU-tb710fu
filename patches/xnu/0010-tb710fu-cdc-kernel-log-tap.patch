diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -263,8 +263,9 @@ _cnputc(char c, bool poll)
 {
 	/* TB710FU: mirror the console into the ramoops zone; skip the CR that
 	 * precedes every LF so the ring keeps whole lines. */
 	if (c != '\r') {
 		tb710fu_ramoops_putc(c);
+		tb710fu_cdc_log_tap_putc(c);
 	}
 	if (boot_progress_active()) { boot_progress_putc(c); return; }
 	bool in_debugger = (kernel_debugger_entry_count > 0);
diff --git a/pexpert/arm/pe_kprintf.c b/pexpert/arm/pe_kprintf.c
--- a/pexpert/arm/pe_kprintf.c
+++ b/pexpert/arm/pe_kprintf.c
@@ -163,6 +163,8 @@ serial_putc_crlf(char c)
 static void
 serial_putc_crlf(char c)
 {
+	extern void tb710fu_cdc_log_tap_putc(char);
+	if (c != '\r') { tb710fu_cdc_log_tap_putc(c); }
 	if (c == '\n') {
 		uart_putc('\r');
 	}
@@ -172,5 +174,7 @@ serial_putc_options(char c, bool poll)
 void
 serial_putc_options(char c, bool poll)
 {
+	extern void tb710fu_cdc_log_tap_putc(char);
+	if (c != '\r') { tb710fu_cdc_log_tap_putc(c); }
 	uart_putc_options(c, poll);
 }
@@ -179,5 +182,7 @@ serial_putc(char c)
 void
 serial_putc(char c)
 {
+	extern void tb710fu_cdc_log_tap_putc(char);
+	if (c != '\r') { tb710fu_cdc_log_tap_putc(c); }
 	uart_putc(c);
 }
