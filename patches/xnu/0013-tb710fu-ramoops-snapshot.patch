-static uint32_t early_len;
 static uint32_t panic_delay = 15, reset_after, reset_warm, selftest;
 
 /*
@@ -259,16 +411,6 @@
 	__asm__ volatile ("dsb sy; smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
 	for (;;) {
