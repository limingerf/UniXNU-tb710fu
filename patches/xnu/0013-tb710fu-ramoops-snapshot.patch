 }
 
@@ -305,18 +447,16 @@
 	PE_parse_boot_argn("ramoops_reset_after", &reset_after, sizeof(reset_after));
 	PE_parse_boot_argn("ramoops_reset_warm", &reset_warm, sizeof(reset_warm));
 	PE_parse_boot_argn("ramoops_selftest", &selftest, sizeof(selftest));
-	if (ramoops_zone_open((volatile uint8_t *)ml_io_map((vm_offset_t)pa, size), size, ecc)) {
+	/* Recheck the final parsed size before mapping, including its span. */
+	if (size <= HDR_BYTES + 2 * RS_BLOCK || size > RAMOOPS_MAX_SIZE ||
+	    ecc > RS_MAX_ROOTS || pa < TB710FU_SPAN_BASE ||
+	    pa > TB710FU_SPAN_END - size) {
 		zone = NULL;
 		return;
 	}
-	static const char banner[] = "\n=== TB710FU XNU boot (UniXNU ramoops) ===\n";
-	for (const char *s = banner; *s; s++) {
-		ramoops_zone_putc(*s);
-	}
-	for (uint32_t i = 0; i < early_len; i++) {
-		ramoops_zone_putc(early[i]);
-	}
-	ramoops_zone_flush();
+	if (ramoops_start_boot((volatile uint8_t *)ml_io_map((vm_offset_t)pa, size), size, ecc)) {
+		return;
+	}
 	if (selftest) {
 		/* ramoops_selftest=1: prove the zone survives this reset type, then reboot at once. */
 		static const char line[] = "ramoops selftest: PSCI reset now, warm=";
@@ -337,7 +477,7 @@
 	if (zone == NULL) {
 		return;
 	}
-	ramoops_zone_flush();
+	(void)ramoops_flush_try();
 	nanoseconds_to_absolutetime((uint64_t)panic_delay * NSEC_PER_SEC, &deadline);
 	deadline += mach_absolute_time();
 	while (mach_absolute_time() < deadline) {
@@ -350,9 +490,9 @@
 {
 	static const char msg[] = "\n=== ramoops_reset_after expired: resetting ===\n";
 	for (const char *s = msg; *s; s++) {
-		ramoops_zone_putc(*s);
-	}
-	ramoops_zone_flush();
+		tb710fu_ramoops_putc(*s);
+	}
+	(void)ramoops_flush_try();
 	psci_system_reset();
 }
 
diff --git a/osfmk/kern/tb710fu_ramoops.h b/osfmk/kern/tb710fu_ramoops.h
--- a/osfmk/kern/tb710fu_ramoops.h
+++ b/osfmk/kern/tb710fu_ramoops.h
@@ -1,8 +1,27 @@
 // SPDX-License-Identifier: MIT
 #ifndef KERN_TB710FU_RAMOOPS_H
 #define KERN_TB710FU_RAMOOPS_H
+#include <stdint.h>
+#include <stddef.h>
 /* Console mirror into the Linux ramoops console zone (boot-arg ramoops=<PA>). */
 void tb710fu_ramoops_init(void);          /* after arm_vm_init */
 void tb710fu_ramoops_putc(char c);        /* every console character */
 void tb710fu_ramoops_panic_reset(void);   /* flush, wait, PSCI SYSTEM_RESET */
+/* Snapshot states are part of the device-owned LiveLog ABI. */
+enum {
+    TB710FU_RAMOOPS_UNMAPPED = 0,
+    TB710FU_RAMOOPS_BUSY = 1,
+    TB710FU_RAMOOPS_EMPTY = 2,
+    TB710FU_RAMOOPS_READY = 3
+};
+struct tb710fu_ramoops_snapshot {
+    uint64_t boot_start, start, end, dropped;
+    uint32_t copied, state;
+};
+/* Returns 0..4096 copied bytes. boot_start is zero in each boot; start/end
+ * count successful current-boot text bytes, excluding old RAM and parity.
+ * NULL output, zero capacity or NULL info returns 0 (UNMAPPED if info exists).
+ * BUSY never waits; no snapshot request changes the persistent zone. */
+int tb710fu_ramoops_snapshot_copy(uint8_t *out, size_t capacity,
+    struct tb710fu_ramoops_snapshot *info);
 #endif
