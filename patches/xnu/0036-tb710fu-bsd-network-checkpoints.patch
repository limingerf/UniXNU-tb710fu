From: TB710FU clean board
Subject: [PATCH] Trace the BSD networking initialization boundaries

Source: XNU ac9718fb1af618d5ce8678d0dc6e8a58f252216f with the ordered
patches recorded by run 44883138301.

The device last displayed shm-sem-init done. Track the four following
calls and the DLIL self-test and worker startup. Replace the ordinary
DLIL wait logs with synchronous text checkpoints outside the wait lock.
The input acknowledgment runs after releasing its locks. The detacher
entry checkpoint runs before acquiring its lock and arming its wait.

Verification: reconstruct the touched files from the pinned revision and
hash-checked run inputs. Check forward application and byte-exact reversal.
---

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -929,14 +929,21 @@
 	 */
 #if NETWORKING
 	bsd_init_kprintf("calling nwk_wq_init\n");
+	TB710FU_BSD_TEXT("nwk-wq-init", "begin\n");
 	nwk_wq_init();
+	TB710FU_BSD_TEXT("nwk-wq-init", "done\n");
 	bsd_init_kprintf("calling dlil_init\n");
+	TB710FU_BSD_TEXT("dlil-init", "begin\n");
 	dlil_init();
+	TB710FU_BSD_TEXT("dlil-init", "done\n");
 #endif /* NETWORKING */
 #if SOCKETS
 	bsd_init_kprintf("calling socketinit\n");
+	TB710FU_BSD_TEXT("socket-init", "begin\n");
 	socketinit();
+	TB710FU_BSD_TEXT("socket-init", "done\n");
 	bsd_init_kprintf("calling domaininit\n");
+	TB710FU_BSD_TEXT("domain-init", "begin\n");
 	domaininit();
 	TB710FU_BSD_TEXT("domain-init", "done\n");
 	iptap_init();

diff --git a/bsd/net/dlil.c b/bsd/net/dlil.c
--- a/bsd/net/dlil.c
+++ b/bsd/net/dlil.c
@@ -1587,7 +1587,9 @@
 
 #if DEBUG || DEVELOPMENT
 	/* Run self-tests */
+	TB710FU_DLIL_TEXT("dlsumbeg", "SUM16 self-test begin");
 	dlil_verify_sum16();
+	TB710FU_DLIL_TEXT("dlsumend", "SUM16 self-test done");
 #endif /* DEBUG || DEVELOPMENT */
 
 	/*
@@ -1595,7 +1597,9 @@
 	 * detacher threads once everything is initialized.
 	 */
 	dlil_incr_pending_thread_count();
+	TB710FU_DLIL_TEXT("dlinmake", "main input thread create begin");
 	(void) dlil_create_input_thread(NULL, dlil_main_input_thread, NULL);
+	TB710FU_DLIL_TEXT("dlindone", "main input thread create done");
 
 	/*
 	 * Create ifnet detacher thread.
@@ -1605,28 +1609,28 @@
 	 * on these interfaces.
 	 */
 	dlil_incr_pending_thread_count();
+	TB710FU_DLIL_TEXT("dldtmake", "detacher thread create begin");
 	if (kernel_thread_start(ifnet_detacher_thread_func,
 	    NULL, &thread) != KERN_SUCCESS) {
 		panic_plain("%s: couldn't create detacher thread", __func__);
 		/* NOTREACHED */
 	}
 	thread_deallocate(thread);
+	TB710FU_DLIL_TEXT("dldtdone", "detacher thread create done");
 
 	/*
 	 * Wait for the created kernel threads for dlil to get
 	 * scheduled and run at least once before we proceed
 	 */
+	TB710FU_DLIL_TEXT("dlwait", "waiting for main input and detacher");
 	lck_mtx_lock(&dlil_thread_sync_lock);
 	while (dlil_pending_thread_cnt != 0) {
-		DLIL_PRINTF("%s: Waiting for all the create dlil kernel "
-		    "threads to get scheduled at least once.\n", __func__);
 		(void) msleep(&dlil_pending_thread_cnt, &dlil_thread_sync_lock,
 		    (PZERO - 1), __func__, NULL);
 		LCK_MTX_ASSERT(&dlil_thread_sync_lock, LCK_ASSERT_OWNED);
 	}
 	lck_mtx_unlock(&dlil_thread_sync_lock);
-	DLIL_PRINTF("%s: All the created dlil kernel threads have been "
-	    "scheduled at least once. Proceeding.\n", __func__);
+	TB710FU_DLIL_TEXT("dlready", "main input and detacher ready");
 }
 
 __private_extern__ int
@@ -5629,6 +5633,7 @@
 ifnet_detacher_thread_func(void *v, wait_result_t w)
 {
 #pragma unused(v, w)
+	TB710FU_DLIL_TEXT("dldtent", "detacher thread entered");
 	dlil_if_lock();
 	(void) assert_wait(&ifnet_delayed_run, THREAD_UNINT);
 	ifnet_detaching_embryonic = TRUE;

diff --git a/bsd/net/dlil_input.c b/bsd/net/dlil_input.c
--- a/bsd/net/dlil_input.c
+++ b/bsd/net/dlil_input.c
@@ -1441,6 +1441,7 @@
 
 		if (__improbable(embryonic)) {
 			dlil_decr_pending_thread_count();
+			TB710FU_DLIL_TEXT("dlinack", "main input startup acknowledged");
 		}
 
 		/*

diff --git a/bsd/net/dlil_var_private.h b/bsd/net/dlil_var_private.h
--- a/bsd/net/dlil_var_private.h
+++ b/bsd/net/dlil_var_private.h
@@ -174,6 +174,20 @@
 	kProtoKPI_v2    = 2
 };
 
+
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
+#include <kern/tb710fu_live_log.h>
+#define TB710FU_DLIL_TEXT(stage, message) \
+	do { \
+		if (tb710fu_live_log_active()) { \
+			printf("TB710FU DLIL: " message "\n"); \
+			tb710fu_live_log_checkpoint_text(stage); \
+		} \
+	} while (0)
+#else
+#define TB710FU_DLIL_TEXT(stage, message) do { } while (0)
+#endif
+
 #if 1
 #define DLIL_PRINTF     printf
 #else
