 	lck_mtx_unlock(&dlil_thread_sync_lock);
 	TB710FU_DLIL_SCHED_END();
-	TB710FU_DLIL_TEXT("dlready", "main input and detacher ready");
+#if defined(XNU_TB710FU_LIVE_LOG) && XNU_TB710FU_LIVE_LOG
