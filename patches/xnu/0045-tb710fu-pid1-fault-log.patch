Log PID 1 unhandled user abort registers and keep COM5 CDC polling alive inside panic halt_all_cpus().

- In sleh.c (handle_user_abort): print pc/lr/sp/far/esr/fsc/code0/x0/x1 for PID 1 and wait 3s
  so cdc_worker drains the line over COM5 before launchd exits.
- In machine_routines.c (halt_all_cpus): enter tb710fu_cdc_panic_loop() so COM5 drains panic
  logs and accepts hands-free "edl" / "reboot" even after any kernel panic.
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index b8856d2..556e7c5 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -922,9 +922,17 @@ halt_all_cpus(boolean_t reboot)
 		PEHaltRestart(kPERestartCPU);
 	} else {
 		printf("CPU halted\n");
+#if defined(XNU_TB710FU_CDC) && XNU_TB710FU_CDC
+		extern void tb710fu_cdc_panic_loop(void);
+		tb710fu_cdc_panic_loop();
+#endif
 		PEHaltRestart(kPEHaltCPU);
 	}
 	while (1) {
+#if defined(XNU_TB710FU_CDC) && XNU_TB710FU_CDC
+		extern void tb710fu_cdc_panic_loop(void);
+		tb710fu_cdc_panic_loop();
+#endif
 		;
 	}
 }
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 0554aa8..30725a6 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -2071,6 +2071,22 @@ handle_user_abort(arm_saved_state_t *state, uint64_t esr, vm_offset_t fault_addr
 	}
 #endif
 
+	{
+		extern int proc_pid(struct proc *);
+		if (__improbable(proc_pid(current_proc()) == 1)) {
+			printf("TB710FU PID1 FAULT: pc=0x%llx lr=0x%llx sp=0x%llx far=0x%llx esr=0x%llx fsc=0x%x code0=%lld x0=0x%llx x1=0x%llx\n",
+			    (unsigned long long)get_saved_state_pc(state),
+			    (unsigned long long)get_saved_state_lr(state),
+			    (unsigned long long)get_saved_state_sp(state),
+			    (unsigned long long)fault_addr,
+			    (unsigned long long)esr,
+			    (unsigned int)fault_code,
+			    (long long)codes[0],
+			    (unsigned long long)get_saved_state_reg(state, 0),
+			    (unsigned long long)get_saved_state_reg(state, 1));
+			delay(3000000);
+		}
+	}
 	codes[1] = fault_addr;
 #if __has_feature(ptrauth_calls)
 	bool is_data_abort = (ESR_EC(esr) == ESR_EC_DABORT_EL0);
