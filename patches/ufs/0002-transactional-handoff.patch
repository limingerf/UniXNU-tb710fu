diff --git a/SmmuTakeover.h b/SmmuTakeover.h
index c30f5a9..dd9e925 100644
--- a/SmmuTakeover.h
+++ b/SmmuTakeover.h
@@ -3,6 +3,9 @@
 struct UfsSmmuPlan {
   unsigned slot = 0xffffffffU, bank = 0, pages = 0;
   uint32_t smr = 0, s2cr = 0;
+  uint16_t stream = 0;
+  uint64_t dma = 0, bytes = 0;
+  uint32_t savedCr0 = 0, savedSmr = 0, savedS2cr = 0, savedCbar = 0, savedCba2r = 0, savedSctlr = 0;
   bool reuse = false;
   const char *error = nullptr;
 };
@@ -22,8 +25,21 @@ template <class Read>
 static UfsSmmuPlan planUfsSmmuBank(uint16_t stream, uint64_t dma, uint64_t bytes, Read read, unsigned bankFromTop)
 {
   UfsSmmuPlan p;
+  p.stream = stream;
+  p.dma = dma;
+  p.bytes = bytes;
+  p.savedCr0 = read(0x0);
+  // SMMUv2 sCR0 bit 0 is CLIENTPD (clear means clients enabled), not
+  // SMMUv3's SMMUEN. This adapter uses SMR.VALID, not extended-ID S2CR.EXIDVALID.
+  if (p.savedCr0 & 9U) {
+    p.error = "SMMU clients disabled or extended stream IDs enabled";
+    return p;
+  }
   uint32_t idr0 = read(0x20), idr2 = read(0x28);
   unsigned count = idr0 & 255;
+  if (!(idr0 & (1U << 27))) {
+    p.error = "SMMU stream matching unsupported"; return p;
+  }
   if (!(idr0 & (1U << 30)) || !(idr2 & (1U << 12))) {
     p.error = "SMMU AArch64 stage 1 unsupported"; return p;
   }
@@ -72,6 +88,13 @@ static UfsSmmuPlan planUfsSmmuBank(uint16_t stream, uint64_t dma, uint64_t bytes
     p.error = "reserved context bank not bypass"; return p;
   }
   if (p.slot == 0xffffffffU) p.error = "no free stream-match group";
+  if (!p.error) {
+    p.savedSmr = read(0x800 + 4 * p.slot);
+    p.savedS2cr = read(0xc00 + 4 * p.slot);
+    p.savedCbar = read(0x1000 + 4 * p.bank);
+    p.savedCba2r = read(0x1800 + 4 * p.bank);
+    p.savedSctlr = sctlr;
+  }
   return p;
 }
 
@@ -125,3 +148,60 @@ static const char *configureUfsSmmu(const UfsSmmuPlan &p, uint16_t stream, Read
     return "SMMU stream mapping readback";
   return nullptr;
 }
+
+template <class Read>
+static bool ufsSmmuPlanUnchanged(const UfsSmmuPlan &p, Read read)
+{
+  UfsSmmuPlan current = planUfsSmmu(p.stream, p.dma, p.bytes, read);
+  return !current.error && current.slot == p.slot && current.bank == p.bank && current.pages == p.pages && current.reuse == p.reuse &&
+         current.savedSmr == p.savedSmr && current.savedS2cr == p.savedS2cr &&
+         current.savedCr0 == p.savedCr0 && current.savedCbar == p.savedCbar && current.savedCba2r == p.savedCba2r &&
+         current.savedSctlr == p.savedSctlr;
+}
+
+// Undo only the registers changed by configureUfsSmmu. A newly published stream
+// is hidden before its context is restored; the original SMR is restored last.
+template <class Read, class Write>
+static bool restoreUfsSmmu(const UfsSmmuPlan &p, Read read, Write write)
+{
+  if (p.error || p.slot == 0xffffffffU) return false;
+  const unsigned smr = 0x800 + 4 * p.slot;
+  const unsigned s2cr = 0xc00 + 4 * p.slot;
+  const unsigned cbar = 0x1000 + 4 * p.bank;
+  const unsigned cba2r = 0x1800 + 4 * p.bank;
+  const unsigned cb = (p.pages + p.bank) * 4096;
+  if (p.reuse) {
+    if (read(cba2r) != p.savedCba2r) write(cba2r, p.savedCba2r);
+    return ufsSmmuPlanUnchanged(p, read);
+  }
+  write(smr, p.savedSmr & ~0x80000000U);
+  if (read(smr) != (p.savedSmr & ~0x80000000U)) return false;
+  write(cb, 0);
+  if (read(cb) != 0) return false;
+  write(cba2r, p.savedCba2r);
+  write(cbar, p.savedCbar);
+  write(s2cr, p.savedS2cr);
+  write(cb, p.savedSctlr);
+  if (read(cba2r) != p.savedCba2r || read(cbar) != p.savedCbar ||
+      read(s2cr) != p.savedS2cr || read(cb) != p.savedSctlr) return false;
+  write(smr, p.savedSmr);
+  return ufsSmmuPlanUnchanged(p, read);
+}
+
+template <class Read, class Write>
+static const char *configureUfsSmmuTransactional(const UfsSmmuPlan &p, Read read, Write write,
+                                                  bool *rollbackVerified)
+{
+  *rollbackVerified = true;
+  if (p.error) return p.error;
+  // The caller has already stopped the host. A stale route cannot be called
+  // restored merely because this helper has not written it: do not resume DMA.
+  if (!ufsSmmuPlanUnchanged(p, read)) {
+    *rollbackVerified = false;
+    return "SMMU changed after preflight";
+  }
+  const char *failure = configureUfsSmmu(p, p.stream, read, write);
+  if (!failure) return nullptr;
+  *rollbackVerified = restoreUfsSmmu(p, read, write);
+  return failure;
+}
