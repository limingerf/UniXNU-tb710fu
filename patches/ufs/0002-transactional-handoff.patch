+      (read32 (gHost.hc, 0x60) & 1) != gHost.originalRunStop ||
+      read32 (gHost.hc, 0x50) != gHost.originalListLow ||
+      read32 (gHost.hc, 0x54) != gHost.originalListHigh) {
