+static bool hostSnapshotOriginalQueue (const char **why)
+{
+  if (!hostReadyIdle (why)) {
+    gHost.queueSnapshotValid = false;
+    return false;
+  }
+  gHost.originalHostEnable = read32 (gHost.hc, 0x34) & 1;
+  gHost.originalHostStatus = read32 (gHost.hc, 0x30) & 0x0f;
+  gHost.originalInterruptEnable = read32 (gHost.hc, 0x24);
+  gHost.originalRunStop = read32 (gHost.hc, 0x60) & 1;
+  gHost.originalListLow = read32 (gHost.hc, 0x50);
+  gHost.originalListHigh = read32 (gHost.hc, 0x54);
+  gHost.originalInterruptStatus = read32 (gHost.hc, 0x20); // W1C; diagnostic only, never restored.
