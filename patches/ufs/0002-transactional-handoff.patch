+  if (read32 (gHost.hc, 0x58) || read32 (gHost.hc, 0x78)) {
+    *why = "cannot restore queue with outstanding request";
+    return false;
+  }
+  uint32_t runStop = read32 (gHost.hc, 0x60) & 1;
+  bool listChanged = read32 (gHost.hc, 0x50) != gHost.originalListLow ||
+                     read32 (gHost.hc, 0x54) != gHost.originalListHigh;
+  if (runStop && (listChanged || !gHost.originalRunStop)) {
+    hostWrite (0x60, 0);
+    if (!hostWaitRegister (0x60, 1, 0)) {
+      *why = "cannot stop replacement request list";
+      return false;
+    }
+    runStop = 0;
+  }
+  if (runStop && listChanged) {
+    *why = "firmware request list changed while running";
+    return false;
+  }
+  if (listChanged) {
+    hostWrite (0x50, gHost.originalListLow);
+    hostWrite (0x54, gHost.originalListHigh);
+  }
+  if (read32 (gHost.hc, 0x50) != gHost.originalListLow ||
+      read32 (gHost.hc, 0x54) != gHost.originalListHigh) {
+    *why = "firmware request list address restore";
+    return false;
+  }
+  if (gHost.originalRunStop &&
+      (!(read32 (gHost.hc, 0x34) & 1) || (read32 (gHost.hc, 0x30) & 0x0f) != 0x0f)) {
+    *why = "controller no longer ready to resume firmware queue";
