+  const char *wanted = gRootPartitionName ? gRootPartitionName : "userdata";
+  size_t wantedLen = 0;
+  while (wanted[wantedLen] && wantedLen <= 31) wantedLen++;
   bool found = false;
   for (uint32_t index = 0; index < count; index++) {
     const uint8_t *entry = gScratch + index * 128;
@@ -122,13 +133,16 @@ static bool findRootLayout (RootLayout *layout, const char **why)
         return false;
       }
     }
-    bool match = true;
-    for (unsigned c = 0; c < sizeof (wanted); c++) {
+    bool match = wantedLen > 0 && wantedLen <= 31;
+    for (unsigned c = 0; match && c < wantedLen; c++) {
       if (entry[56 + 2 * c] != static_cast<uint8_t> (wanted[c]) || entry[57 + 2 * c] != 0) {
         match = false;
         break;
       }
     }
+    // UTF-16 name field is NUL terminated: the word right after the name must also be NUL,
+    // otherwise a short name would match a longer partition that merely starts with it.
+    if (match && entry[56 + 2 * wantedLen] != 0) match = false;
     if (match) {
