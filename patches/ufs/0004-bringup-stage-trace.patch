+  ufsCheckpoint ("ufscent");
+  if (!hostClearUcd ()) {
+    printf ("NativeUfs: host cmd-ucd-refused\n");
+    return kIOReturnNotReady;
+  }
+  printf ("NativeUfs: host cmd-ucd-cleared\n");
+  ufsCheckpoint ("ufscucd");
   uint8_t *ucd = gHost.virt + kUcdOffset;
   ucd[0] = 0x01;                      // COMMAND UPIU
   ucd[1] = direction == 2 ? 0x40 : direction == 1 ? 0x20 : 0x00;   // R: data in, W: data out
@@ -176,6 +195,8 @@ static IOReturn hostScsiDir (uint8_t lun, const uint8_t *cdb, unsigned cdbLength
     ucd[16 + index] = cdb[index];
   }
   uint32_t ocs = 0xf;
+  printf ("NativeUfs: host cmd-submit\n");
+  ufsCheckpoint ("ufscsub");
   IOReturn status = hostSubmit (direction ? direction : 0U, dataBytes, timeoutUs, &ocs);
   if (status != kIOReturnSuccess) return status;
   status = hostResponseHeader (0x21, lun, 0);
diff --git a/TransferPoll.h b/TransferPoll.h
index 2f56e30..b84624c 100644
--- a/TransferPoll.h
+++ b/TransferPoll.h
@@ -15,6 +15,13 @@ static UfsTransferEnd pollUfsTransfer(Port &port, UfsTransferPoll &state)
     uint32_t doorbell = port.doorbell();
     state.doorbellSeen |= doorbell;
     state.interruptSeen |= port.interrupt();
+    // Periodic state dump so a spin that never exits still shows what the
+    // controller is doing. Prints, then continues exactly as before.
+    if ((state.polls % 1000U) == 0U) {
+      printf("NativeUfs: poll polls=%u db=%08x is=%08x ocs=%u expired=%u\n",
