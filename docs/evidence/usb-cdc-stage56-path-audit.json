        "pe_arm_init_interrupts(void *args)",
        "{",
        "\tkprintf(\"pe_arm_init_interrupts: args: %p\\n\", args);",
        "",
        "\t/* Set up mappings for interrupt controller and possibly timers (if they haven't been set up already) */",
        "\tif (args != NULL) {",
        "\t\tif (!pe_arm_map_interrupt_controller()) {",
        "\t\t\treturn 0;",
        "\t\t}",
        "\t}",
        "",
        "\treturn pe_arm_init_timer(args);",
        "}",
        "",
        "static uint32_t",
        "pe_arm_init_timer(void *args)",
        "{",
        "\tvm_offset_t     pic_base = 0;",
        "\tvm_offset_t     timer_base = 0;",
        "\tvm_offset_t     soc_phys;",
        "\tvm_offset_t     eoi_addr = 0;",
        "\tuint32_t        eoi_value = 0;",
        "\tstruct tbd_ops  generic_funcs = {&fleh_fiq_generic, NULL, NULL};",
        "\tstruct tbd_ops  empty_funcs __unused = {NULL, NULL, NULL};",
        "\ttbd_ops_t       tbd_funcs = &generic_funcs;",
        "",
        "\t/* The SoC headers expect to use pic_base, timer_base, etc... */",
        "\tpic_base = gPicBase;",
        "\ttimer_base = gTimerBase;",
        "\tsoc_phys = gSocPhys;",
        "",
        "#if defined(__arm64__)",
        "\ttbd_funcs = &empty_funcs;",
        "#else",
        "\treturn 0;",
        "#endif",
        "",
        "\tif (args != NULL) {",
        "\t\tml_init_timebase(args, tbd_funcs, eoi_addr, eoi_value);",
        "\t}",
        "",
        "\treturn 1;",
        "}"
      ]
    },
