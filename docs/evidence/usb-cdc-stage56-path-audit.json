  "source_guidance": [
    {
      "path": ".work/xnu-patch-lf-clean/osfmk/arm/arm_init.c",
      "sha256": "936c00f99ed80065526031114384f6937503a5ffd93e671231f75d97aaa99f91",
      "first_line": 581,
      "last_line": 708,
      "lines": [
        "\tgDramBase = *dram_base;",
        "\tgDramSize = *dram_size;",
        "\tpmap_first_pnum = (ppnum_t)atop(gDramBase);",
        "",
        "\tboot_progress_stage(\"arm_vm_init enter\");",
        "\tarm_vm_init(xmaxmem, args);",
        "\t/* TB710FU: the zone is map-able once the kernel VM is up. */",
        "\ttb710fu_ramoops_init();",
        "\tboot_progress_stage(\"arm_vm_init returned\");",
        "",
        "\tif (debug_boot_arg) {",
        "\t\tpatch_low_glo();",
        "\t}",
        "",
        "#if __arm64__ && WITH_CLASSIC_S2R",
        "\tsleep_token_buffer_init();",
        "#endif",
        "",
        "\tPE_consistent_debug_inherit();",
        "",
        "\t/* Setup debugging output. */",
        "\tconst unsigned int serial_exists = serial_init();",
        "\tkernel_startup_initialize_upto(STARTUP_SUB_KPRINTF);",
        "\tkprintf(\"kprintf initialized\\n\");",
        "",
        "\tserialmode = 0;",
        "\tif (PE_parse_boot_argn(\"serial\", &serialmode, sizeof(serialmode))) {",
        "\t\t/* Do we want a serial keyboard and/or console? */",
        "\t\tkprintf(\"Serial mode specified: %08X\\n\", serialmode);",
        "\t\tdisable_iolog_serial_output = (serialmode & SERIALMODE_NO_IOLOG) != 0;",
        "\t\tenable_dklog_serial_output = restore_boot || (serialmode & SERIALMODE_DKLOG) != 0;",
        "\t\tint force_sync = serialmode & SERIALMODE_SYNCDRAIN;",
        "\t\tif (force_sync || PE_parse_boot_argn(\"drain_uart_sync\", &force_sync, sizeof(force_sync))) {",
        "\t\t\tif (force_sync) {",
        "\t\t\t\tserialmode |= SERIALMODE_SYNCDRAIN;",
        "\t\t\t\tkprintf(",
        "\t\t\t\t\t\"WARNING: Forcing uart driver to output synchronously.\"",
        "\t\t\t\t\t\"printf()s/IOLogs will impact kernel performance.\\n\"",
        "\t\t\t\t\t\"You are advised to avoid using 'drain_uart_sync' boot-arg.\\n\");",
        "\t\t\t}",
        "\t\t}",
        "\t\t/* If on-demand is selected, disable serials until reception. */",
        "\t\tbool on_demand = !!(serialmode & SERIALMODE_ON_DEMAND);",
        "\t\tif (on_demand && !(serialmode & SERIALMODE_INPUT)) {",
        "\t\t\tkprintf(",
        "\t\t\t\t\"WARNING: invalid serial boot-args : ON_DEMAND (0x%x) flag \"",
        "\t\t\t\t\"requires INPUT(0x%x). Ignoring ON_DEMAND.\\n\",",
        "\t\t\t\tSERIALMODE_ON_DEMAND, SERIALMODE_INPUT",
        "\t\t\t\t);",
        "\t\t\ton_demand = 0;",
        "\t\t}",
        "\t\tserial_set_on_demand(on_demand);",
        "\t}",
        "\tif (kern_feature_override(KF_SERIAL_OVRD)) {",
        "\t\tserialmode = 0;",
        "\t}",
        "",
        "\t/* Start serial if requested and a serial device was enumerated in serial_init(). */",
        "\tif ((serialmode & SERIALMODE_OUTPUT) && serial_exists) {",
        "\t\tserial_console_enabled = true;",
        "\t\t(void)switch_to_serial_console(); /* Switch into serial mode from video console */",
        "\t\tdisableConsoleOutput = FALSE;     /* Allow printfs to happen */",
        "\t}",
        "\tPE_create_console();",
        "",
        "\t/* setup console output */",
        "\tPE_init_printf(FALSE);",
        "",
        "#if __arm64__",
        "#if DEBUG",
        "\tdump_kva_space();",
        "#endif",
        "#endif",
        "",
        "\tcpu_machine_idle_init(TRUE);",
        "",
        "\tPE_init_platform(TRUE, &BootCpuData);",
        "",
        "\t/* Initialize the debug infrastructure system-wide and on the local core. */",
        "\tpe_arm_debug_init_early(&BootCpuData);",
        "",
        "#if __arm64__",
        "\textern bool cpu_config_correct;",
        "\tif (!cpu_config_correct) {",
