        "\tthread->last_made_runnable_time = mach_absolute_time();",
        "\tthread_set_thread_name(thread, \"kernel_bootstrap_thread\");",
        "",
        "\tthread_deallocate(thread);",
        "",
        "\tkernel_bootstrap_log(\"load_context - done\");",
