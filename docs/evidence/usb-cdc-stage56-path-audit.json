        "\tkernel_bootstrap_log(\"kernel_thread_create\");",
        "\tresult = kernel_thread_create((thread_continue_t)kernel_bootstrap_thread, NULL, MAXPRI_KERNEL, &thread);",
        "",
        "\tif (result != KERN_SUCCESS) {",
        "\t\tpanic(\"kernel_bootstrap: result = %08X\", result);",
        "\t}",
        "",
        "\t/* TODO: do a proper thread_start() (without the thread_setrun()) */",
